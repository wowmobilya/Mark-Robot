# Example only. NOT a complete production config until the placeholders below
# are replaced on an Internet-reachable Ubuntu 22.04/24.04 host.
# See README.md; keep the real secret out of GitHub and the public website.
listening-port=3478
tls-listening-port=5349
fingerprint
realm=turn.YOUR_DOMAIN.example
server-name=turn.YOUR_DOMAIN.example
use-auth-secret
static-auth-secret=REPLACE_WITH_A_PRIVATE_RANDOM_64_HEX_SECRET
min-port=49160
max-port=49259
total-quota=100
user-quota=4
stale-nonce
no-cli
no-loopback-peers
no-multicast-peers
no-tlsv1
no-tlsv1_1
cert=/etc/coturn/tls/fullchain.pem
pkey=/etc/coturn/tls/privkey.pem
# Add external-ip=PUBLIC_IP if the server is behind NAT.
# For 1:1 NAT: external-ip=PUBLIC_IP/PRIVATE_RELAY_IP.
# Allow TCP 3478, 5349 and UDP 3478, 49160-49259 in host + cloud firewall.
# Never enable anonymous/long-term static user credentials.
